{
  "name": "narok",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "bun --env-file=.env --env-file=.env.local run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file=.env run dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "bun test src",
    "ingest": "bun --env-file=.env --env-file=.env.local run src/scripts/ingest.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.4.29",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.0",
    "typescript": "6.0.3"
  }
}
