# Postgres + ParadeDB
DATABASE_URL=postgres://narok:changeme@localhost:5433/narok

# llama-server (embedding + génération, même instance ou deux endpoints distincts)
LLAMA_EMBEDDING_URL=http://localhost:8091
LLAMA_CHAT_URL=http://localhost:8092

# Optionnel — uniquement pour `bun run eval --rerank`, pas utilisé en production (le reranking
# n'a pas montré de gain, voir docs-internal/conventions.md). Instance llama-server chargée d'un
# modèle reranker, lancée avec --reranking --pooling rank -b 4096 -ub 4096
# LLAMA_RERANK_URL=http://localhost:8093

# Port HTTP exposé par cette API
API_PORT=8100
